# このファイルを .dev.vars にコピーして値を入れる（.dev.vars は gitignore 済み）
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Azure Neural TTS を使うときだけ（アプリの TTS_PROVIDER = azure）。Speech リソースの「キーとエンドポイント」のキー
AZURE_SPEECH_KEY=
TYPESAFE_API_KEY=
# 最初の 1 台をつなぐための予備の家族トークン（ダッシュボードで発行したものも使える）
FAMILY_TOKEN=

# 親のダッシュボード（/dashboard）の Google ログイン
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# セッション Cookie の署名用。`openssl rand -base64 32` などで作る
SESSION_SECRET=
# ログインを許可するメールアドレス（カンマ区切り）
PARENT_EMAILS=

# 1 にすると localhost からのアクセスだけ Google ログインを省く（画面の確認用）。
# ここ（.dev.vars）にだけ書く。wrangler.jsonc の vars や本番の secret には絶対に入れない
# DEV_AUTH_BYPASS=1
