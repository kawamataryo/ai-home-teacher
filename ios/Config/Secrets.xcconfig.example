// cp Config/Secrets.xcconfig.example Config/Secrets.xcconfig して値を入れる。
// xcconfig では "//" がコメント扱いになるため、URL は "https:/$()/..." と書く。

WORKER_BASE_URL = http:/$()/localhost:8787
FAMILY_TOKEN = dev-family-token
// 先生の声: azure（既定。Worker に AZURE_SPEECH_KEY が必要）/ elevenlabs
TTS_PROVIDER = azure
DEVELOPMENT_TEAM =
